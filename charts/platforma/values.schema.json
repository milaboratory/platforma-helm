{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Platforma Helm Chart Values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"]
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkSecrets": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "string",
      "enum": ["", "aws", "gcp"]
    },
    "license": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        }
      },
      "required": ["secretName", "secretKey"],
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "showUserList": {
          "type": "boolean"
        },
        "providers": {
          "description": "Auth providers, as a list. Each entry carries a name, which is the provider id, and a type of sso, htpasswd or ldap. Entries are advertised to clients in the order written here, and a client opens its login form on the first one. Earlier chart versions took a map keyed by provider id: convert each key into an entry with that key as its name.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 40
              },
              "type": {
                "type": "string",
                "enum": ["sso", "htpasswd", "ldap"]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "sso": {
                "type": "object",
                "properties": {
                  "issuer": {
                    "type": "string"
                  },
                  "clientId": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "string"
                  },
                  "resource": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string",
                    "enum": ["", "none", "login", "consent", "select_account"]
                  },
                  "accessType": {
                    "type": "string",
                    "enum": ["", "online", "offline"]
                  },
                  "userIdClaim": {
                    "type": "string"
                  },
                  "subjectTokenSource": {
                    "type": "string",
                    "enum": ["", "access_token", "id_token"]
                  },
                  "redirectPorts": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "jwtAlgorithms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "clientSecret": {
                    "type": "object",
                    "properties": {
                      "secretName": {
                        "type": "string"
                      },
                      "secretKey": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "htpasswd": {
                "type": "object",
                "properties": {
                  "credentials": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        }
                      },
                      "required": ["username", "password"]
                    }
                  },
                  "secretName": {
                    "type": "string"
                  },
                  "secretKey": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "ldap": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "userDN": {
                    "type": "string"
                  },
                  "bindDN": {
                    "type": "string"
                  },
                  "bindPassword": {
                    "type": "string"
                  },
                  "baseDN": {
                    "type": "string"
                  },
                  "userFilter": {
                    "type": "string"
                  },
                  "searchRules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "groupBaseDN": {
                    "type": "string"
                  },
                  "startTLS": {
                    "type": "boolean"
                  },
                  "insecureTLS": {
                    "type": "boolean"
                  },
                  "trustedCASecretRef": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "key": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "clientCertSecretRef": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "certKey": {
                        "type": "string"
                      },
                      "keyKey": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "lookUpAttr": {
                "type": "string"
              },
              "trustUnverifiedEmail": {
                "type": "boolean"
              },
              "createUsers": {
                "type": "boolean"
              },
              "map": {
                "type": "object",
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "fullName": {
                    "type": "string"
                  },
                  "externalId": {
                    "type": "string"
                  },
                  "groups": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "mapFields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "adminUsers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "roles": {
                "type": "object",
                "properties": {
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "groupRegexps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "attrRegexps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "google": {
                "type": "object",
                "properties": {
                  "groupFetch": {
                    "type": "boolean"
                  },
                  "apiTimeout": {
                    "type": "string",
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
                  },
                  "apiRetries": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["name", "type"],
            "additionalProperties": false
          }
        },
        "extensionFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "htpasswd": {
          "type": "object",
          "properties": {
            "credentials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": ["username", "password"]
              }
            },
            "secretName": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "ldap": {
          "type": "object",
          "properties": {
            "server": {
              "type": "string"
            },
            "startTLS": {
              "type": "boolean"
            },
            "bindDN": {
              "type": "string"
            },
            "searchRules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "searchUser": {
              "type": "string"
            },
            "searchPassword": {
              "type": "string"
            },
            "searchPasswordSecretRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "tls": {
              "type": "object",
              "properties": {
                "insecureSkipVerify": {
                  "type": "boolean"
                },
                "caSecretRef": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "clientCertSecretRef": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "certKey": {
                      "type": "string"
                    },
                    "keyKey": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sso": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "resource": {
              "type": "string"
            },
            "prompt": {
              "type": "string",
              "enum": ["", "none", "login", "consent", "select_account"]
            },
            "accessType": {
              "type": "string",
              "enum": ["", "online", "offline"]
            },
            "userIdClaim": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            },
            "clientSecret": {
              "type": "object",
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "secretKey": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "masterSecret": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "database": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "properties": {
            "existingClaim": {
              "type": "string"
            },
            "efs": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "fileSystemId": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "fsxLustre": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "fileSystemId": {
                  "type": "string"
                },
                "dnsName": {
                  "type": "string"
                },
                "mountName": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "filestore": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "instanceName": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "shareName": {
                  "type": "string"
                },
                "ip": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "nfs": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "server": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "pvc": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "chownOnCreate": {
                  "type": "boolean"
                },
                "accessMode": {
                  "type": "string",
                  "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"],
                  "default": "ReadWriteMany"
                },
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "main": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["", "s3", "gcs"]
            },
            "s3": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "externalEndpoint": {
                  "type": "string"
                },
                "noDataIntegrity": {
                  "type": "boolean"
                },
                "secretRef": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "accessKeyField": {
                      "type": "string"
                    },
                    "secretKeyField": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "gcs": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "projectId": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                },
                "serviceAccount": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dataSources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["pvc", "s3", "gcs"]
          },
          "pvc": {
            "type": "object",
            "properties": {
              "existingClaim": {
                "type": "string"
              }
            },
            "required": ["existingClaim"]
          },
          "s3": {
            "type": "object",
            "properties": {
              "bucket": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "endpoint": {
                "type": "string"
              },
              "secretRef": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "accessKeyField": {
                    "type": "string",
                    "default": "access-key"
                  },
                  "secretKeyField": {
                    "type": "string",
                    "default": "secret-key"
                  }
                }
              },
              "externalEndpoint": {
                "type": "string"
              },
              "noDataIntegrity": {
                "type": "boolean"
              }
            },
            "required": ["bucket"]
          },
          "gcs": {
            "type": "object",
            "properties": {
              "bucket": {
                "type": "string"
              },
              "projectId": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "serviceAccount": {
                "type": "string"
              }
            },
            "required": ["bucket"]
          }
        },
        "required": ["name", "type"]
      }
    },
    "kueue": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dedicated", "shared"]
        },
        "imagePullMaxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "oomRetry": {
          "type": "boolean"
        },
        "maxJobResources": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": ["integer", "string"]
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+Gi$"
            },
            "gpuMemory": {
              "type": "string",
              "pattern": "^[0-9]+Gi$"
            },
            "gpuCpu": {
              "type": ["integer", "string"]
            },
            "gpuRam": {
              "type": "string",
              "pattern": "^[0-9]+Gi$"
            }
          },
          "additionalProperties": false
        },
        "pools": {
          "type": "object",
          "properties": {
            "ui": {
              "type": "object",
              "properties": {
                "nodeSelector": {
                  "type": "object"
                },
                "tolerations": {
                  "type": "array"
                }
              }
            },
            "batch": {
              "type": "object",
              "properties": {
                "nodeSelector": {
                  "type": "object"
                },
                "tolerations": {
                  "type": "array"
                }
              }
            },
            "gpu": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "tolerations": {
                  "type": "array"
                },
                "devicePlugin": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "dedicated": {
          "type": "object",
          "properties": {
            "createClusterResources": {
              "type": "boolean",
              "default": true
            },
            "clusterResourceName": {
              "type": "string"
            },
            "resources": {
              "type": "object",
              "properties": {
                "ui": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": ["integer", "string"]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "batch": {
                  "type": "object",
                  "properties": {
                    "cpu": {
                      "type": ["integer", "string"]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                },
                "gpu": {
                  "type": "object",
                  "properties": {
                    "gpu": {
                      "type": ["integer", "string"]
                    },
                    "cpu": {
                      "type": ["integer", "string"]
                    },
                    "memory": {
                      "type": "string"
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "provisioningRequest": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "shared": {
          "type": "object",
          "properties": {
            "clusterQueues": {
              "type": "object",
              "properties": {
                "ui": {
                  "type": "string"
                },
                "batch": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "workloadPriorityClasses": {
              "type": "object",
              "properties": {
                "uiTasks": {
                  "type": "string"
                },
                "high": {
                  "type": "string"
                },
                "normal": {
                  "type": "string"
                },
                "low": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "additionalIngress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "podLabels": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "serviceAnnotations": {
          "type": "object"
        },
        "serviceAppProtocols": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "secretVariables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "secretName": {
                    "type": "string"
                  },
                  "secretKey": {
                    "type": "string"
                  }
                },
                "required": ["name", "secretName", "secretKey"]
              }
            },
            "configMapVariables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "configMapName": {
                    "type": "string"
                  },
                  "configMapKey": {
                    "type": "string"
                  }
                },
                "required": ["name", "configMapName", "configMapKey"]
              }
            }
          },
          "additionalProperties": false
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debug": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "logging": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
