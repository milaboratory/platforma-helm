# =============================================================================
# platforma — example variables
# =============================================================================
# Copy to terraform.tfvars and edit. Apply AFTER infra. The shared
# identifiers below MUST match the values you gave infra (the IRSA
# trust policies, ACM cert, ECR cache, and Kueue quotas were wired up there
# against these exact values). Everything else is discovered by name/tag.
# =============================================================================

# --- Shared identifiers — must match infra -------------------------
region              = "eu-central-1"
cluster_name        = "platforma-cluster"
platforma_namespace = "platforma"
helm_release_name   = "platforma"
deployment_size     = "small"
enable_gpu          = true

ingress_enabled = true
domain_name     = "platforma.example.com"
route53_zone_id = "Z0123456789ABCDEFGHIJ"

# --- The one value the module cannot derive by name --------------------------
# The auto-generated bucket name carries a random suffix. Take it from infra:
#   terraform -chdir=../infra output -raw s3_bucket_name
s3_bucket_name = "platforma-platforma-cluster-ab12cd34"

# --- Platforma release -------------------------------------------------------
# deploy_platforma = true   # false = controllers only (stage infra first)

# License (required when deploy_platforma = true). Either inline...
license_key = "your-license-key"
# ...or point at a pre-existing secret holding MI_LICENSE:
# license_secret_name = "platforma-license"

# Master secret (required). Name of a pre-existing SSM SecureString parameter
# holding the Platforma root key. Stage it before apply:
#   aws ssm put-parameter --type SecureString --name <name> --value "$(openssl rand -base64 32)"
master_secret_ssm_parameter_name = "/your-cluster-name/platforma/master-secret"

# Chart source: pinned OCI release by default. Override for a local chart:
# chart_version    = "4.1.2"
# chart_local_path = "../../../../charts/platforma"   # dev / air-gapped
# platforma_image  = "quay.io/milaboratories/platforma:1.2.3"  # repository:tag

# --- Authentication: htpasswd (default) or ldap ------------------------------
auth_method = "htpasswd"
# Empty htpasswd_content auto-generates one 'platforma' user; the password is
# stored in SSM (see `terraform output htpasswd_password_command`).
# Provide your own with: htpasswd -nB <user>  (bcrypt recommended)
# htpasswd_content = "platforma:$2y$05$..."

# LDAP instead:
# auth_method          = "ldap"
# ldap_server          = "ldaps://ldap.example.com:636"
# ldap_start_tls       = false  # forced false for ldaps:// (already encrypted)
# ldap_bind_dn         = "cn=%u,ou=users,dc=example,dc=com"
# ldap_search_user     = "cn=svc,ou=svc,dc=example,dc=com"
# ldap_search_password = "..."
# ldap_search_rules    = ["(uid=%u)|ou=users,dc=example,dc=com"]

# --- Data libraries — pass the SAME list given to infra ------------
# data_libraries = [
#   { name = "reference-genomes", bucket = "my-in-account-bucket", prefix = "genomes/" },
#   { name = "partner-data", bucket = "partner-external-bucket", region = "us-east-1", access_key = "AKIA...", secret_key = "..." },
# ]

# MiLaboratories' read-only demo library (cross-account, embedded creds).
enable_demo_data_library = true

# --- Extra Platforma server args -----------------------------------
# Appended after the flags this module may set based on other config
# options (e.g. --default-docker-registry). Each element is one whole argument.
# additional_extra_args = ["--some-flag=value"]
