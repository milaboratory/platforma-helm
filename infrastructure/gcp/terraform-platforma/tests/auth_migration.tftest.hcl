run "an_unrelated_extra_arg_passes" {
  command = plan

  variables {
    auth_method           = ""
    sso_provider          = "none"
    ldap_server           = ""
    enable_local_users    = false
    htpasswd_content      = ""
    sso_admin_users       = ""
    ldap_admin_users      = ""
    local_admin_users     = ""
    additional_extra_args = ["--default-docker-registry=x"]
  }

  assert {
    condition     = length(local.auth_providers) == 1
    error_message = "an unrelated extra arg must not be treated as a leftover admin flag"
  }
}

run "local_users_without_htpasswd_content_refused" {
  command = plan

  variables {
    auth_method        = ""
    sso_provider       = "none"
    ldap_server        = ""
    enable_local_users = true
    htpasswd_content   = ""
    sso_admin_users    = ""
    ldap_admin_users   = ""
    local_admin_users  = ""
  }

  expect_failures = [helm_release.platforma[0]]
}

run "local_users_with_htpasswd_content_passes" {
  command = plan

  variables {
    auth_method        = ""
    sso_provider       = "none"
    ldap_server        = ""
    enable_local_users = true
    htpasswd_content   = "alice:$apr1$hash"
    sso_admin_users    = ""
    ldap_admin_users   = ""
    local_admin_users  = ""
  }

  assert {
    condition     = [for p in local.auth_providers : p.name] == ["local", "admin"]
    error_message = "enable_local_users with htpasswd_content set must plan"
  }
}

