  command = plan

  variables {
    auth_method        = ""
    sso_provider       = "none"
    ldap_server        = ""
    enable_local_users = true
    htpasswd_content   = "local:$apr1$hash"
    sso_admin_users    = ""
    ldap_admin_users   = ""
