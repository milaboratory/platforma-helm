run "admin_regexps_land_under_their_own_source" {
  command = plan

  variables {
    auth_method          = ""
    sso_provider         = "google"
    google_client_id     = "regexp-client-id"
    google_client_secret = "regexp-client-secret"
    ldap_server          = "ldaps://ldap.example.com:636"
    ldap_search_password = "search-pw"
    enable_local_users   = true
    htpasswd_content     = "regexp:$apr1$hash"
    sso_admin_users      = "alice@example.com;^ops-.*$"
    ldap_admin_users     = "svc-admin"
    local_admin_users    = ""
  }

  assert {
    condition     = one([for p in local.auth_providers : p if p.type == "sso"]).roles.attrRegexps == ["admin=login=alice@example.com", "admin=login=^ops-.*$"]
    error_message = "the SSO entry must carry sso_admin_users as attrRegexps"
  }

  assert {
    condition     = one([for p in local.auth_providers : p if p.type == "ldap"]).roles.attrRegexps == ["admin=login=svc-admin"]
    error_message = "the corp entry must carry ldap_admin_users as attrRegexps"
  }

  assert {
    condition     = !contains(keys(one([for p in local.auth_providers : p if p.name == "local"])), "roles")
    error_message = "the local entry must carry no roles key when local_admin_users is empty"
  }

  assert {
    condition     = !contains(keys(one([for p in local.auth_providers : p if p.name == "admin"])), "roles")
    error_message = "the admin entry grants by adminUsers, never by roles"
  }
}

run "admin_regexps_trim_spaces_and_drop_the_trailing_empty_pattern" {
  command = plan

  variables {
    auth_method          = ""
    sso_provider         = "google"
    google_client_id     = "trim-client-id"
    google_client_secret = "trim-client-secret"
    ldap_server          = ""
    enable_local_users   = false
    htpasswd_content     = ""
    sso_admin_users      = " alice@example.com ; ^ops-.*$ ; "
    ldap_admin_users     = ""
    local_admin_users    = ""
  }

  assert {
    condition     = one([for p in local.auth_providers : p if p.type == "sso"]).roles.attrRegexps == ["admin=login=alice@example.com", "admin=login=^ops-.*$"]
    error_message = "surrounding spaces and a trailing semicolon must not add an empty or unspaced pattern"
  }
}

