run "legacy_google_selector_ignores_a_leftover_ldap_server" {
  command = plan

  variables {
    auth_method          = "google"
    sso_provider         = "none"
    google_client_id     = "leftover-ldap-id"
    google_client_secret = "leftover-ldap-secret"
    ldap_server          = "ldaps://ldap.example.com:636"
    enable_local_users   = false
    htpasswd_content     = ""
    sso_admin_users      = ""
    ldap_admin_users     = ""
    local_admin_users    = ""
  }

  assert {
    condition     = [for p in local.auth_providers : p.name] == ["google", "admin"]
    error_message = "a legacy google selector must not also advertise corp from a leftover ldap_server"
  }

  assert {
    condition     = length(kubernetes_secret.ldap_search_password) == 0
    error_message = "the ldap_search_password Secret must not be created when corp is not advertised"
  }
}

