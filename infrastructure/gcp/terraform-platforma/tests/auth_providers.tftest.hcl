# Proves local.auth_providers combines every configured source, admin last,
# and that the per-source required-field checks read the resolved set.
#
# Variable values come from *.auto.tfvars.json placed next to the module by
# test-sso-tfvars.sh (generated by install.sh), so every run block below pins
# the whole auth variable set itself rather than trusting the installer's
# defaults for it.

mock_provider "google" {}
mock_provider "google-beta" {}
mock_provider "kubernetes" {}
mock_provider "helm" {}
mock_provider "kubectl" {}
mock_provider "http" {}
mock_provider "random" {}

variables {
  appwrapper_install_yaml_sha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

override_data {
  target = data.http.appwrapper_manifest
  values = {
    response_body = ""
  }
}

override_data {
  target = data.kubectl_file_documents.appwrapper
  values = {
    documents = []
    manifests = {
      "/api/v1/namespaces/appwrapper-system" = "apiVersion: v1\nkind: Namespace\nmetadata:\n  name: appwrapper-system\n"
    }
  }
}

override_data {
  target = data.google_filestore_instance.workspace
  values = {
    file_shares = [{
      name               = "share"
      capacity_gb        = 1024
      nfs_export_options = []
      source_backup      = ""
    }]
    networks = [{
      ip_addresses      = ["10.0.0.2"]
      connect_mode      = "DIRECT_PEERING"
      modes             = ["MODE_IPV4"]
      network           = "default"
      reserved_ip_range = ""
    }]
  }
}

override_data {
  target = data.google_secret_manager_secret_version.master_secret
  values = {
    secret_data = "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
  }
}

run "combination_advertises_every_source_admin_last" {
  command = plan

  variables {
    auth_method          = ""
    sso_provider         = "google"
    google_client_id     = "combo-client-id"
    google_client_secret = "combo-client-secret"
    ldap_server          = "ldaps://ldap.example.com:636"
    ldap_search_password = "search-pw"
    enable_local_users   = true
    htpasswd_content     = "combo:$apr1$hash"
    sso_admin_users      = ""
    ldap_admin_users     = ""
    local_admin_users    = ""
  }

  assert {
    condition     = [for p in local.auth_providers : p.name] == ["google", "corp", "local", "admin"]
    error_message = "combined config must advertise google, corp, local, admin in that order"
  }

  assert {
    condition     = [for p in local.auth_providers : p.type] == ["sso", "ldap", "htpasswd", "htpasswd"]
    error_message = "each source's provider type must match its slot"
  }

  assert {
    condition     = length(kubernetes_secret.sso_client_secret) == 1 && length(kubernetes_secret.ldap_search_password) == 1 && length(kubernetes_secret.htpasswd_provided) == 1
    error_message = "all three auth Secrets must be created when every source is configured"
  }

  assert {
    condition     = one([for p in local.auth_providers : p if p.type == "ldap"]).ldap.bindPasswordSecretRef == { name = "platforma-ldap-search-password", key = "password" }
    error_message = "the corp entry must name its bind password by bindPasswordSecretRef"
  }
}

run "admin_floor_alone_when_nothing_is_set" {
  command = plan

  variables {
    auth_method        = ""
    sso_provider       = "none"
    ldap_server        = ""
    enable_local_users = false
    htpasswd_content   = ""
    sso_admin_users    = ""
    ldap_admin_users   = ""
    local_admin_users  = ""
  }

  assert {
    condition     = length(local.auth_providers) == 1 && local.auth_providers[0].name == "admin"
    error_message = "with no source configured, the admin floor must be the only entry"
  }

  assert {
    condition     = local.auth_providers[0].title == "Administrator" && local.auth_providers[0].adminUsers == [var.admin_username]
    error_message = "the admin entry must carry the Administrator title and grant admin_username"
  }

  assert {
    condition     = length(local.auth_providers[0].htpasswd.credentials) == 1 && local.auth_providers[0].htpasswd.credentials[0].username == var.admin_username
    error_message = "the admin entry must carry one inline credential for admin_username"
  }

  assert {
    condition     = length(kubernetes_secret.htpasswd_provided) == 0 && length(kubernetes_secret.ldap_search_password) == 0 && length(kubernetes_secret.sso_client_secret) == 0
    error_message = "no auth Secret should be created when no source is configured"
  }
}

